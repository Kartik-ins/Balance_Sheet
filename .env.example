# Environment Configuration
# Copy this to .env and fill in your values

# Application
APP_NAME=Financial Assurance Platform
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/assurance.db

# OpenRouter API (for explanation generation)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-3-27b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agent Configuration
AUTO_APPROVE_CONFIDENCE_THRESHOLD=0.85
ESCALATION_RISK_THRESHOLD=0.7
VARIANCE_ZSCORE_THRESHOLD=2.5
VARIANCE_PERCENT_THRESHOLD=0.25

# Materiality Thresholds (by band)
MATERIALITY_HIGH_THRESHOLD=1000000
MATERIALITY_MEDIUM_THRESHOLD=100000
MATERIALITY_LOW_THRESHOLD=10000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (for task queue - optional)
REDIS_URL=redis://localhost:6379/0
